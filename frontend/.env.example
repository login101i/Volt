# =============================================================================
# Volt Frontend (Next.js) — environment variables
# Copy to .env.local:  cp .env.example .env.local
# =============================================================================

# --- REQUIRED (API connection to Express backend) ----------------------------
# Must match server PORT (default/docs: 5000)
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- REQUIRED only for S3 image upload via /api/media ------------------------
# Used by app/api/media/route.ts (signed PUT URLs)
# Without these, component image upload to S3 will fail
ACCESS_KEY=
SECRET_KEY=
REGION=eu-central-1
BUCKET_NAME=

# --- OPTIONAL: landing commit activity graph ---------------------------------
# Override repo for /api/dev-activity (default: login101i/Volt)
# DEV_PULSE_GITHUB_REPO=login101i/Volt

# --- OPTIONAL (interview page only) ------------------------------------------
# DATABASE_URL=
